    {
      "id": "jLVxHTGJbZDy8zkunC6n",
      "type": "text",
      "x": 6440,
      "y": 4839.9,
      "width": 740,
      "height": 570,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "KzBYfOnPv2AafoAsfYc3",
      "roundness": null,
      "seed": 239251323,
      "version": 3,
      "versionNonce": 185379504,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1795094419016,
      "link": null,
      "locked": false,
      "text": "prog = {\n    ('q0', '_'): ('_', 'L', 'q1'),\n    ('q1', '_'): ('_', 'R', 'q2'),\n    ('q1', '0'): ('0', 'L', 'q1'),\n    ('q1', '1'): ('1', 'L', 'q1'),\n    ('q2', '1'): ('_', 'R', 'q3'),\n    ('q3', '0'): ('1', 'S', 'q3'),\n    ('q3', '1'): ('1', 'S', 'q3'),\n}\ns = list('_' * 3 + bin(1514)[2:] + '_' * 3)\ni = len(s) - 3\nq = 'q0'\nwhile True:\n    a, d, q = prog[q, s[i]]\n    s[i] = a\n    if d == 'L': i -= 1\n    if d == 'R': i += 1\n    if d == 'S': break\nprint(int(''.join(s).strip('_'), 2))",
      "originalText": "prog = {\n    ('q0', '_'): ('_', 'L', 'q1'),\n    ('q1', '_'): ('_', 'R', 'q2'),\n    ('q1', '0'): ('0', 'L', 'q1'),\n    ('q1', '1'): ('1', 'L', 'q1'),\n    ('q2', '1'): ('_', 'R', 'q3'),\n    ('q3', '0'): ('1', 'S', 'q3'),\n    ('q3', '1'): ('1', 'S', 'q3'),\n}\ns = list('_' * 3 + bin(1514)[2:] + '_' * 3)\ni = len(s) - 3\nq = 'q0'\nwhile True:\n    a, d, q = prog[q, s[i]]\n    s[i] = a\n    if d == 'L': i -= 1\n    if d == 'R': i += 1\n    if d == 'S': break\nprint(int(''.join(s).strip('_'), 2))",
      "fontSize": 24,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "index": "c0Jy",
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
