      "versionNonce": 2143599419,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795100000000,
      "link": null,
      "locked": false,
      "text": "В 2026 году решили 60,3 % участников (ФИПИ).\nПовышенный уровень, 1 первичный балл, около 6 минут.",
      "originalText": "В 2026 году решили 60,3 % участников (ФИПИ).\nПовышенный уровень, 1 первичный балл, около 6 минут.",
      "fontSize": 30,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.35,
      "index": "c005",
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "MOCa5PPvps4sUpvttm3A",
      "type": "text",
      "x": 60,
      "y": 450,
      "width": 293.72,
      "height": 48.6,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
