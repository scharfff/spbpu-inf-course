      "updated": 1794917000000,
      "link": null,
      "locked": false,
      "text": "Пример. Четному N справа дописывают 0, нечетному 11. Наименьшее N, при котором R > 50.",
      "originalText": "Пример. Четному N справа дописывают 0, нечетному 11. Наименьшее N, при котором R > 50.",
      "fontSize": 26,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.35,
      "index": "c03P",
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
