      "seed": 1648802961,
      "version": 3,
      "versionNonce": 772332112,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1795094829305,
      "link": null,
      "locked": false,
      "text": "prog = {\n    ('q0', '_'): ('_', 'L', 'q1'),\n    ('q1', '_'): ('1', 'L', 'q2'),\n    ('q1', '0'): ('1', 'S', 'q1'),\n    ('q1', '1'): ('0', 'L', 'q1'),\n    ('q2', '_'): ('_', 'S', 'q2'),\n}\ns = list('_' * 3 + bin(2047)[2:] + '_' * 3)\ni = len(s) - 3\nq = 'q0'\nwhile True:\n    a, d, q = prog[q, s[i]]\n    s[i] = a\n    if d == 'L': i -= 1\n    if d == 'R': i += 1\n    if d == 'S': break\nprint(int(''.join(s).strip('_'), 2))",
      "originalText": "prog = {\n    ('q0', '_'): ('_', 'L', 'q1'),\n    ('q1', '_'): ('1', 'L', 'q2'),\n    ('q1', '0'): ('1', 'S', 'q1'),\n    ('q1', '1'): ('0', 'L', 'q1'),\n    ('q2', '_'): ('_', 'S', 'q2'),\n}\ns = list('_' * 3 + bin(2047)[2:] + '_' * 3)\ni = len(s) - 3\nq = 'q0'\nwhile True:\n    a, d, q = prog[q, s[i]]\n    s[i] = a\n    if d == 'L': i -= 1\n    if d == 'R': i += 1\n    if d == 'S': break\nprint(int(''.join(s).strip('_'), 2))",
      "fontSize": 24,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "index": "c0NE",
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "bkvVWWzlcDvzybejOHsI",
      "type": "text",
      "x": 1500,
