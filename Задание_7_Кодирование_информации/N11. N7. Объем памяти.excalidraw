      "link": null,
      "locked": false,
      "text": "L, K, V = 440, 1892412, 305726 * 1024\nfor i in range(1, 20):\n    b = (L * i + 7) // 8\n    if K * b >= V:\n        print(2 ** (i - 1) + 1)\n        break",
      "originalText": "L, K, V = 440, 1892412, 305726 * 1024\nfor i in range(1, 20):\n    b = (L * i + 7) // 8\n    if K * b >= V:\n        print(2 ** (i - 1) + 1)\n        break",
      "fontSize": 22,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
