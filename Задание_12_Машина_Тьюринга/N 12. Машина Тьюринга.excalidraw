      "isDeleted": false,
      "boundElements": [],
      "updated": 1795100000000,
      "link": null,
      "locked": false,
      "text": "было = 342 + k, значит хвост берем подлиннее",
      "originalText": "было = 342 + k, значит хвост берем подлиннее",
      "fontSize": 32,
