      "text": "f\"{x:08b}\"",
      "originalText": "f\"{x:08b}\"",
      "fontSize": 24,
      "fontFamily": 8,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "6D2XWihCYqaUNeUQNo_79",
