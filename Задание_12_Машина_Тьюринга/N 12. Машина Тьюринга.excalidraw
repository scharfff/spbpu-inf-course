    {
      "id": "dA5A7UMOSnzWdNNZuGkr",
      "type": "text",
      "x": 4690,
      "y": 2065,
      "width": 680,
      "height": 510,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1485235027,
      "version": 4,
      "versionNonce": 580357200,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1795092298731,
      "link": null,
      "locked": false,
      "text": "prog = {\n    ('q0', '_'): ('_', 'L', 'q1'),\n    ('q1', '_'): ('1', 'L', 'q2'),\n    ('q1', '0'): ('0', 'L', 'q1'),\n    ('q1', '1'): ('1', 'L', 'q1'),\n    ('q2', '_'): ('_', 'S', 'q2'),\n}\ns = list('_' * 3 + bin(2025)[2:] + '_' * 3)\ni = len(s) - 3\nq = 'q0'\nwhile True:\n    a, d, q = prog[q, s[i]]\n    s[i] = a\n    if d == 'L': i -= 1\n    if d == 'R': i += 1\n    if d == 'S': break\nprint(int(''.join(s).strip('_'), 2))",
      "originalText": "prog = {\n    ('q0', '_'): ('_', 'L', 'q1'),\n    ('q1', '_'): ('1', 'L', 'q2'),\n    ('q1', '0'): ('0', 'L', 'q1'),\n    ('q1', '1'): ('1', 'L', 'q1'),\n    ('q2', '_'): ('_', 'S', 'q2'),\n}\ns = list('_' * 3 + bin(2025)[2:] + '_' * 3)\ni = len(s) - 3\nq = 'q0'\nwhile True:\n    a, d, q = prog[q, s[i]]\n    s[i] = a\n    if d == 'L': i -= 1\n    if d == 'R': i += 1\n    if d == 'S': break\nprint(int(''.join(s).strip('_'), 2))",
      "fontSize": 24,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "index": "c06Y",
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "SXdOp81zXn3zgM2I7oOe",
      "type": "text",
      "x": 5440,
      "y": 2083,
      "width": 404.64,
      "height": 59.4,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
