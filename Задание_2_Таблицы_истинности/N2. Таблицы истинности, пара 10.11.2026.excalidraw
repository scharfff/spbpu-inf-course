  {
   "id": "J9CfSxcJrMDIj37cJtBT",
   "type": "text",
   "x": 802,
   "y": 3960,
   "width": 607.1999999999999,
   "height": 220.0,
   "angle": 0,
   "strokeColor": "#1b2a4a",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": "EvhhlEe7x7uVS42eXabk",
   "roundness": null,
   "seed": 878270633,
   "version": 1,
   "versionNonce": 26500971,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1794306060087,
   "link": null,
   "locked": false,
   "text": "print('w x y z')\nfor w in [0, 1]:\n    for x in [0, 1]:\n        for y in [0, 1]:\n            for z in [0, 1]:\n                F = (not w) and z and (y <= x)\n                if F == 1:\n                    print(w, x, y, z)",
   "originalText": "print('w x y z')\nfor w in [0, 1]:\n    for x in [0, 1]:\n        for y in [0, 1]:\n            for z in [0, 1]:\n                F = (not w) and z and (y <= x)\n                if F == 1:\n                    print(w, x, y, z)",
   "fontSize": 22,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
