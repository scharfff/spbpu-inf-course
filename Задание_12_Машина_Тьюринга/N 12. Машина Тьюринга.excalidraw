      "versionNonce": 1575799865,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795100000000,
      "link": null,
      "locked": false,
      "text": "q1 на нуле пишет 1 и идет влево, на единице пишет 0 и стоп",
      "originalText": "q1 на нуле пишет 1 и идет влево, на единице пишет 0 и стоп",
      "fontSize": 32,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "c0jo",
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "ycPS1kz2FL2LIRX0zwpr",
      "type": "text",
      "x": 2551,
      "y": 9997.48,
      "width": 947.46,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "7n8A2JBTwr5sQ1bAlNgi",
      "roundness": null,
      "seed": 1943470448,
      "version": 2,
      "versionNonce": 620760619,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795100000000,
      "link": null,
      "locked": false,
      "text": "пусть в хвосте k нулей. Единиц стало (было - 1 + k) = 220",
      "originalText": "пусть в хвосте k нулей. Единиц стало (было - 1 + k) = 220",
      "fontSize": 32,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "c0jp",
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "19XijPZLVeCoAR0KpknW",
      "type": "text",
      "x": 2551,
      "y": 10055.48,
      "width": 952.88,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "7n8A2JBTwr5sQ1bAlNgi",
      "roundness": null,
      "seed": 1024454836,
      "version": 2,
      "versionNonce": 2037551244,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795100000000,
      "link": null,
      "locked": false,
      "text": "единиц было 221 - k, нулей было 570 - (221 - k) = 349 + k",
      "originalText": "единиц было 221 - k, нулей было 570 - (221 - k) = 349 + k",
      "fontSize": 32,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "c0jq",
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "l21xOP2wCZ7LUJGfQnOC",
      "type": "text",
      "x": 2551,
      "y": 10113.48,
      "width": 972.69,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "7n8A2JBTwr5sQ1bAlNgi",
      "roundness": null,
      "seed": 1262250033,
      "version": 2,
      "versionNonce": 2054425816,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795100000000,
      "link": null,
      "locked": false,
      "text": "единица перед хвостом нужна, 221 - k >= 1, значит k <= 220",
      "originalText": "единица перед хвостом нужна, 221 - k >= 1, значит k <= 220",
      "fontSize": 32,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
