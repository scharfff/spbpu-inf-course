      "roundness": null,
      "seed": 1417934733,
      "version": 2,
      "versionNonce": 1649160550,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794917000000,
      "link": null,
      "locked": false,
      "text": "for N in range(1, 1000):\n    b = bin(N)[2:]\n    if N % 2 == 0:\n        b = b + \"0\"\n    else:\n        b = b + \"11\"\n    R = int(b, 2)\n    if R > 50:\n        print(N)\n        break",
      "originalText": "for N in range(1, 1000):\n    b = bin(N)[2:]\n    if N % 2 == 0:\n        b = b + \"0\"\n    else:\n        b = b + \"11\"\n    R = int(b, 2)\n    if R > 50:\n        print(N)\n        break",
      "fontSize": 26,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "c03R",
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
