      "link": null,
      "locked": false,
      "text": "#N\nbest = 1000000\nfor N in range(1, 1000):\n    b = bin(N)[2:]\n    if N % 2 == 0:\n        R = \"11\" + b + \"11\"\n    else:\n        R = \"1\" + b + \"00\"\n    R = int(R,2)\n    if R > 119:\n        best = min(best,R)\nprint(best)",
      "originalText": "#N\nbest = 1000000\nfor N in range(1, 1000):\n    b = bin(N)[2:]\n    if N % 2 == 0:\n        R = \"11\" + b + \"11\"\n    else:\n        R = \"1\" + b + \"00\"\n    R = int(R,2)\n    if R > 119:\n        best = min(best,R)\nprint(best)",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
