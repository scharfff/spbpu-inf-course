      "seed": 913880342,
      "version": 2,
      "versionNonce": 785520787,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795100000000,
      "link": null,
      "locked": false,
      "text": "def to_3(N):\n    s = \"\"\n    while N > 0:\n        s += str(N % 3)\n        N //= 3\n    return s[::-1]\n\nfor N in range(1000, 0, -1):\n    t = to_3(N)\n    if N % 3 == 0:\n        t = \"1\" + t + \"02\"\n    else:\n        t = t + to_3(N % 3 * 4)\n    R = int(t, 3)\n    if R < 199:\n        print(N)\n        break",
      "originalText": "def to_3(N):\n    s = \"\"\n    while N > 0:\n        s += str(N % 3)\n        N //= 3\n    return s[::-1]\n\nfor N in range(1000, 0, -1):\n    t = to_3(N)\n    if N % 3 == 0:\n        t = \"1\" + t + \"02\"\n    else:\n        t = t + to_3(N % 3 * 4)\n    R = int(t, 3)\n    if R < 199:\n        print(N)\n        break",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
