    {
      "id": "Ee3aqkJGMvQ30mNikKt1",
      "type": "text",
      "x": 1340,
      "y": 475,
      "width": 1352.59,
      "height": 75.6,
      "angle": 0,
      "strokeColor": "#1b2a4a",
      "backgroundColor": "transparent",
