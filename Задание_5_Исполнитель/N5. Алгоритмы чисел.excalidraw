      "updated": 1795530295378,
      "link": null,
      "locked": false,
      "text": "for N in range(1, 1000):\n    b = bin(N)[2:]\n    if N % 2 == 0:\n        R = b + \"01\"\n    else:\n        R = \"1\" + b + \"1\"\n    R = int(R, 2)\n    if R > 156:\n        print(N)\n        break",
      "originalText": "for N in range(1, 1000):\n    b = bin(N)[2:]\n    if N % 2 == 0:\n        R = b + \"01\"\n    else:\n        R = \"1\" + b + \"1\"\n    R = int(R, 2)\n    if R > 156:\n        print(N)\n        break",
      "fontSize": 28,
