      "id": "e7v6P9pHMzvv4Lzu8wqK",
      "type": "text",
      "x": 1520,
      "y": 7373.7,
      "width": 700,
      "height": 420,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "ctifGGwjHkxeb7M9w83r",
      "roundness": null,
      "seed": 1888250431,
      "version": 10,
      "versionNonce": 1359298341,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795531255164,
      "link": null,
      "locked": false,
      "text": "for N in range(1, 1000):\n    b = bin(N)[2:]\n    if b.count(\"1\") % 2 == 0:\n        b = b + \"0\"\n        R = \"10\" + b[2:]\n    else:\n        b = b + \"1\"\n        R = \"11\" + b[2:]\n    R = int(R, 2)\n    if R >= 16:\n        print(N)\n        break",
      "originalText": "for N in range(1, 1000):\n    b = bin(N)[2:]\n    if b.count(\"1\") % 2 == 0:\n        b = b + \"0\"\n        R = \"10\" + b[2:]\n    else:\n        b = b + \"1\"\n        R = \"11\" + b[2:]\n    R = int(R, 2)\n    if R >= 16:\n        print(N)\n        break",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
