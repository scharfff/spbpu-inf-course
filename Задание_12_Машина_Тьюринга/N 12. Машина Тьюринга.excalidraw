    {
      "id": "7RWYP6FU8DppiEDUVECP",
      "type": "text",
      "x": 1520,
      "y": 4780.1,
      "width": 740,
      "height": 510,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "FqBtFaZI3R2J0qtwvWPS",
      "roundness": null,
      "seed": 1618457406,
      "version": 3,
      "versionNonce": 627771568,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1795093507483,
      "link": null,
      "locked": false,
      "text": "prog = {\n    ('q0', '_'): ('_', 'L', 'q1'),\n    ('q1', '_'): ('1', 'L', 'q2'),\n    ('q1', '0'): ('0', 'L', 'q1'),\n    ('q1', '1'): ('1', 'L', 'q1'),\n    ('q2', '_'): ('_', 'S', 'q2'),\n}\ns = list('_' * 3 + bin(2025)[2:] + '_' * 3)\ni = len(s) - 3\nq = 'q0'\nwhile True:\n    a, d, q = prog[q, s[i]]\n    s[i] = a\n    if d == 'L': i -= 1\n    if d == 'R': i += 1\n    if d == 'S': break\nprint(int(''.join(s).strip('_'), 2))",
      "originalText": "prog = {\n    ('q0', '_'): ('_', 'L', 'q1'),\n    ('q1', '_'): ('1', 'L', 'q2'),\n    ('q1', '0'): ('0', 'L', 'q1'),\n    ('q1', '1'): ('1', 'L', 'q1'),\n    ('q2', '_'): ('_', 'S', 'q2'),\n}\ns = list('_' * 3 + bin(2025)[2:] + '_' * 3)\ni = len(s) - 3\nq = 'q0'\nwhile True:\n    a, d, q = prog[q, s[i]]\n    s[i] = a\n    if d == 'L': i -= 1\n    if d == 'R': i += 1\n    if d == 'S': break\nprint(int(''.join(s).strip('_'), 2))",
      "fontSize": 24,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "index": "c0BS",
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
