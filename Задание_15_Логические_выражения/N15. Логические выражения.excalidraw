    {
      "id": "Wy1MfjaiJ1KajpUZNQeG",
      "type": "text",
      "x": 2960,
      "y": 135.4,
      "width": 1450.28,
      "height": 75.6,
      "angle": 0,
      "strokeColor": "#1b2a4a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
