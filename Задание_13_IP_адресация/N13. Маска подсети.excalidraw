      "text": "from ipaddress import ip_network\na = \"192.168.40.128/255.255.255.240\"\ncnt = 0\nfor ip in ip_network(a, strict=False):\n    if bin(int(ip)).count(\"1\") % 2 == 1:\n        cnt += 1\nprint(cnt)",
