      "roundness": null,
      "seed": 2082726017,
      "version": 2,
      "versionNonce": 1618100506,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794830000000,
      "link": null,
      "locked": false,
      "text": "IP-адреса узла сети относится к адресу сети, а какая к адресу самого узла в этой сети. Обычно маска",
      "originalText": "IP-адреса узла сети относится к адресу сети, а какая к адресу самого узла в этой сети. Обычно маска",
      "fontSize": 28,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.35,
      "index": "bAd",
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "XCCwOO84EMBACIu9kOax",
      "type": "text",
      "x": 4960,
      "y": 4324.5,
      "width": 1276.48,
      "height": 37.8,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "XVuV9OMKimLVQsc8OXOB",
      "roundness": null,
      "seed": 698007444,
