    {
      "id": "Hsw6nmpSGOPIdR0HpKDU",
      "type": "text",
      "x": 6440,
      "y": 11029.7,
      "width": 700,
      "height": 630,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "LXEgbnY4SIBOmVNsgmst",
      "roundness": null,
      "seed": 1590083954,
      "version": 2,
      "versionNonce": 1074410826,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795100000000,
      "link": null,
      "locked": false,
      "text": "def to_3(N):\n    s = \"\"\n    while N > 0:\n        s += str(N % 3)\n        N //= 3\n    return s[::-1]\n\nbest = 10 ** 9\nfor N in range(1, 1000):\n    t = to_3(N)\n    if N % 3 == 0:\n        t = t + t[-2:]\n    else:\n        t = t + to_3(N % 3 * 5)\n    R = int(t, 3)\n    if R > 150:\n        best = min(best, R)\nprint(best)",
      "originalText": "def to_3(N):\n    s = \"\"\n    while N > 0:\n        s += str(N % 3)\n        N //= 3\n    return s[::-1]\n\nbest = 10 ** 9\nfor N in range(1, 1000):\n    t = to_3(N)\n    if N % 3 == 0:\n        t = t + t[-2:]\n    else:\n        t = t + to_3(N % 3 * 5)\n    R = int(t, 3)\n    if R > 150:\n        best = min(best, R)\nprint(best)",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "index": "c0dg",
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
