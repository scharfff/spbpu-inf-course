      "isDeleted": false,
      "boundElements": [],
      "updated": 1795100000000,
      "link": null,
      "locked": false,
      "text": "for N in range(1, 1000):\n    b = bin(N)[2:]\n    if b.count(\"1\") % 2 == 0:\n        b = b + \"00\"\n        b = \"11\" + b[2:]\n    else:\n        b = b + \"01\"\n        b = \"10\" + b[2:]\n    R = int(b, 2)\n    if R > 96:\n        print(N)\n        break",
      "originalText": "for N in range(1, 1000):\n    b = bin(N)[2:]\n    if b.count(\"1\") % 2 == 0:\n        b = b + \"00\"\n        b = \"11\" + b[2:]\n    else:\n        b = b + \"01\"\n        b = \"10\" + b[2:]\n    R = int(b, 2)\n    if R > 96:\n        print(N)\n        break",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
