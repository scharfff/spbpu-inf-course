    },
    {
      "id": "L5xs7cU8DDrR9o24XfXa",
      "type": "text",
      "x": 60,
      "y": 509,
      "width": 1015.94,
      "height": 121.5,
      "angle": 0,
      "strokeColor": "#1b2a4a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "omJtIbP9ltWoY9LRItk3",
      "roundness": null,
      "seed": 1309581373,
      "version": 2,
      "versionNonce": 1800952237,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795100000000,
      "link": null,
      "locked": false,
      "text": "Дана программа исполнителя МТ в виде таблицы и начальная лента.\nНужно выполнить программу и сказать, что осталось на ленте. Чаще\nвсего это число в десятичной записи или количество символов.",
      "originalText": "Дана программа исполнителя МТ в виде таблицы и начальная лента.\nНужно выполнить программу и сказать, что осталось на ленте. Чаще\nвсего это число в десятичной записи или количество символов.",
      "fontSize": 30,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.35,
      "index": "c007",
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "Hix21eELXS81LpHlx2sN",
      "type": "text",
      "x": 60,
      "y": 660.5,
      "width": 413.87,
      "height": 48.6,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "omJtIbP9ltWoY9LRItk3",
      "roundness": null,
      "seed": 1426663567,
      "version": 2,
      "versionNonce": 1750892056,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795100000000,
      "link": null,
      "locked": false,
      "text": "Что в демоверсии 2027",
      "originalText": "Что в демоверсии 2027",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.35,
      "index": "c008",
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "7ahRBMtsKxnWgAGybHpu",
      "type": "text",
      "x": 60,
      "y": 719.5,
      "width": 1051.93,
      "height": 121.5,
      "angle": 0,
      "strokeColor": "#1b2a4a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "omJtIbP9ltWoY9LRItk3",
      "roundness": null,
      "seed": 1402317363,
      "version": 2,
      "versionNonce": 1882299381,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795100000000,
      "link": null,
      "locked": false,
      "text": "На ленте двоичная запись числа 2025, головка справа. Программа\nдописывает единицу слева от числа, ответ 4073. Сдвигов в условии три\n(L, R, S). В задачах 2026 года описан еще N, без сдвига.",
      "originalText": "На ленте двоичная запись числа 2025, головка справа. Программа\nдописывает единицу слева от числа, ответ 4073. Сдвигов в условии три\n(L, R, S). В задачах 2026 года описан еще N, без сдвига.",
      "fontSize": 30,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.35,
      "index": "c009",
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "kq7jOusOcpvp9BYKRTBA",
      "type": "text",
      "x": 60,
      "y": 871,
      "width": 204.97,
      "height": 48.6,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "omJtIbP9ltWoY9LRItk3",
      "roundness": null,
      "seed": 1881326536,
