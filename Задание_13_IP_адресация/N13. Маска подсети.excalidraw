      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "eVmtE7tdUoLyZBIl3LL8",
      "type": "text",
      "x": 4960,
      "y": 4274.5,
      "width": 1348.16,
      "height": 37.8,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
