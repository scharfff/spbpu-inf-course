    {
      "id": "Qv9aAkzxbemHBDB8Elik",
      "type": "text",
      "x": 62,
      "y": 1614.6,
      "width": 344.2,
      "height": 325,
      "angle": 0,
      "strokeColor": "#1b2a4a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
