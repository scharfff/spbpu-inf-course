    {
      "id": "3pXIWZiAhxlWiBEsdHDs",
      "type": "text",
      "x": 7640,
      "y": 2604.7,
      "width": 1588.04,
      "height": 29.7,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
