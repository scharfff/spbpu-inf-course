      "versionNonce": 936947527,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795100000000,
      "link": null,
      "locked": false,
      "text": "Что спрашивают",
      "originalText": "Что спрашивают",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
