      "text": "from ipaddress import ip_network\na = \"122.159.136.144/255.255.255.248\"\ncnt = 0\nfor ip in ip_network(a, strict=False):\n    if bin(int(ip)).count(\"1\") % 4 != 0:\n        cnt += 1\nprint(cnt)",
