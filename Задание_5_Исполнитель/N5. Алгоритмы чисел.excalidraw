    {
      "id": "arSEoEGh6E0TM3ZhjEAH",
      "type": "text",
      "x": 3980,
      "y": 7373.7,
      "width": 700,
      "height": 420,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
