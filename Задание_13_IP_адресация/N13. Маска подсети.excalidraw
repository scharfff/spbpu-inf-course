      "link": null,
      "locked": false,
      "text": "k = 0\nfor x in range(144, 152):\n    s = bin(122)[2:] + bin(159)[2:] + bin(136)[2:] + bin(x)[2:]\n    if s.count(\"1\") % 4 != 0:\n        k += 1\nprint(k)",
      "originalText": "k = 0\nfor x in range(144, 152):\n    s = bin(122)[2:] + bin(159)[2:] + bin(136)[2:] + bin(x)[2:]\n    if s.count(\"1\") % 4 != 0:\n        k += 1\nprint(k)",
      "fontSize": 30,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
