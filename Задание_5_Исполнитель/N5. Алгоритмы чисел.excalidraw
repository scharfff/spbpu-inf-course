      "index": "c0LWV",
      "roundness": null,
      "seed": 2035822891,
      "version": 244,
      "versionNonce": 714499371,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795530172083,
      "created": 1795529882195,
      "link": null,
      "locked": false,
      "text": "\nfor N in range(1,1000):\n    b = bin(N)[2:]\n    if N % 2 == 0:\n        R = \"10\" + b\n    else:\n        R = \"1\" + b + \"01\"\n    R = int(R,2)\n    if R >= 190:\n        print(N)\n        break",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\nfor N in range(1,1000):\n    b = bin(N)[2:]\n    if N % 2 == 0:\n        R = \"10\" + b\n    else:\n        R = \"1\" + b + \"01\"\n    R = int(R,2)\n    if R >= 190:\n        print(N)\n        break",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
