      "updated": 1795100000000,
      "link": null,
      "locked": false,
      "text": "best = 10 ** 9\nfor N in range(1, 1000):\n    b = bin(N)[2:]\n    b = b + str(b.count(\"1\") % 2)\n    b = b + str(b.count(\"1\") % 2)\n    R = int(b, 2)\n    if R > 75:\n        best = min(best, R)\nprint(best)",
      "originalText": "best = 10 ** 9\nfor N in range(1, 1000):\n    b = bin(N)[2:]\n    b = b + str(b.count(\"1\") % 2)\n    b = b + str(b.count(\"1\") % 2)\n    R = int(b, 2)\n    if R > 75:\n        best = min(best, R)\nprint(best)",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
