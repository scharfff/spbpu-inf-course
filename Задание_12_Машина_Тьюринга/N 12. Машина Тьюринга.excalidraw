      "versionNonce": 806331653,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795100000000,
      "link": null,
      "locked": false,
      "text": "Как решать",
      "originalText": "Как решать",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.35,
      "index": "c00A",
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "ZpOxmT9Rc8Fb4VfIrMTt",
      "type": "text",
      "x": 60,
      "y": 930,
      "width": 1028.24,
      "height": 162,
      "angle": 0,
      "strokeColor": "#1b2a4a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "omJtIbP9ltWoY9LRItk3",
      "roundness": null,
      "seed": 1611769677,
      "version": 2,
      "versionNonce": 1259763148,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795100000000,
      "link": null,
      "locked": false,
      "text": "Нарисовать ленту, прогнать программу на коротком примере из трех\nили пяти символов, назвать словами роль каждого состояния и\nперенести вывод на число из условия. Python нужен как калькулятор,\nbin и int.",
      "originalText": "Нарисовать ленту, прогнать программу на коротком примере из трех\nили пяти символов, назвать словами роль каждого состояния и\nперенести вывод на число из условия. Python нужен как калькулятор,\nbin и int.",
      "fontSize": 30,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.35,
      "index": "c00B",
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "BWYojp9pUfxrfmMPgeY9",
      "type": "text",
      "x": 60,
      "y": 1122,
      "width": 195.13,
      "height": 48.6,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
