      "link": null,
      "locked": false,
      "text": "for A in range(200, -1, -1):\n  ok = True\n  for x in range(0, 200):\n    for y in range(0, 200):\n      if ((2 * x + y != 70) or (x < y) or (A < x))\n== 0:\n        ok = False\n  if ok:\n    print(A)\n    break",
      "originalText": "for A in range(200, -1, -1):\n  ok = True\n  for x in range(0, 200):\n    for y in range(0, 200):\n      if ((2 * x + y != 70) or (x < y) or (A < x)) == 0:\n        ok = False\n  if ok:\n    print(A)\n    break",
      "fontSize": 28,
      "fontFamily": 8,
