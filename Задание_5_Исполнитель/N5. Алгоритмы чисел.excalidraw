    {
      "id": "nsEktlnkY6MJtdSZuqp7",
      "type": "text",
      "x": 1520,
      "y": 11029.7,
      "width": 700,
      "height": 595,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "o6YJOC6n7mdgVQ8hky2E",
      "roundness": null,
      "seed": 1431963547,
      "version": 2,
      "versionNonce": 1757239850,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795100000000,
      "link": null,
      "locked": false,
      "text": "def to_3(N):\n    s = \"\"\n    while N > 0:\n        s += str(N % 3)\n        N //= 3\n    return s[::-1]\n\nfor N in range(1, 1000):\n    t = to_3(N)\n    if N % 3 == 0:\n        t = \"1\" + t + \"02\"\n    else:\n        t = t + to_3(N % 3 * 5)\n    R = int(t, 3)\n    if R >= 177:\n        print(N)\n        break",
      "originalText": "def to_3(N):\n    s = \"\"\n    while N > 0:\n        s += str(N % 3)\n        N //= 3\n    return s[::-1]\n\nfor N in range(1, 1000):\n    t = to_3(N)\n    if N % 3 == 0:\n        t = \"1\" + t + \"02\"\n    else:\n        t = t + to_3(N % 3 * 5)\n    R = int(t, 3)\n    if R >= 177:\n        print(N)\n        break",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
