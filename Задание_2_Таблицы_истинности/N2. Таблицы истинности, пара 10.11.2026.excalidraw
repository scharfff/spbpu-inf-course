   "roundness": null,
   "seed": 1777843622,
   "version": 1,
   "versionNonce": 1934574556,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1794306060087,
   "link": null,
   "locked": false,
   "text": "print('w x y z')\nfor w in [0, 1]:\n    for x in [0, 1]:\n        for y in [0, 1]:\n            for z in [0, 1]:\n                F = (x or y) and (not (y == z)) and (not w)\n                if F == 1:\n                    print(w, x, y, z)",
   "originalText": "print('w x y z')\nfor w in [0, 1]:\n    for x in [0, 1]:\n        for y in [0, 1]:\n            for z in [0, 1]:\n                F = (x or y) and (not (y == z)) and (not w)\n                if F == 1:\n                    print(w, x, y, z)",
   "fontSize": 19,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
