    {
      "id": "h01u50C4PHUpnKg3jo3X",
      "type": "text",
      "x": 3980,
      "y": 11029.7,
      "width": 700,
      "height": 595,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
