      "link": null,
      "locked": false,
      "text": "for N in range(1000, 0, -1):\n    b = bin(N)[2:]\n    b = b + str(b.count(\"1\") % 2)\n    b = b + str(b.count(\"1\") % 2)\n    R = int(b, 2)\n    if R < 86:\n        print(N)\n        break",
