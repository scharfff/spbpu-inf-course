   "text": "print('w x y z')\nfor w in [0, 1]:\n    for x in [0, 1]:\n        for y in [0, 1]:\n            for z in [0, 1]:\n                F = (not (z <= x)) or (y <= w) or (not y)\n                if F == 0:\n                    print(w, x, y, z)",
   "originalText": "print('w x y z')\nfor w in [0, 1]:\n    for x in [0, 1]:\n        for y in [0, 1]:\n            for z in [0, 1]:\n                F = (not (z <= x)) or (y <= w) or (not y)\n                if F == 0:\n                    print(w, x, y, z)",
   "fontSize": 19,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
