      "isDeleted": false,
      "boundElements": [],
      "updated": 1795706064951,
      "link": null,
      "locked": false,
      "text": "strict=False обязателен, иначе ValueError, если адрес узла не\nсовпадает с адресом сети.",
      "originalText": "strict=False обязателен, иначе ValueError, если адрес узла не\nсовпадает с адресом сети.",
