      "roundness": null,
      "seed": 1944634084,
      "version": 2,
      "versionNonce": 892494994,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794830000000,
      "link": null,
      "locked": false,
      "text": "записывается в виде десятичного числа. При этом в маске сначала (в старших разрядах) стоят единицы, а",
      "originalText": "записывается в виде десятичного числа. При этом в маске сначала (в старших разрядах) стоят единицы, а",
      "fontSize": 28,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.35,
      "index": "bAf"
    },
    {
      "id": "K4745AOMIzdXbvEHYajn",
      "type": "text",
      "x": 4960,
      "y": 4424.5,
      "width": 1310.76,
      "height": 37.8,
      "angle": 0,
      "strokeColor": "#1e1e1e",
