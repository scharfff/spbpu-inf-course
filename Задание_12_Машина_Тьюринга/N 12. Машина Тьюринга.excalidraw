      "versionNonce": 776257494,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795100000000,
      "link": null,
      "locked": false,
      "text": "пусть в хвосте k нулей. Нулей стало (было - k + 1) = 343",
      "originalText": "пусть в хвосте k нулей. Нулей стало (было - k + 1) = 343",
      "fontSize": 32,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
