      "updated": 1795100000000,
      "link": null,
      "locked": false,
      "text": "q1 на нуле пишет 1 и идет влево, на единице пишет 0 и стоп",
      "originalText": "q1 на нуле пишет 1 и идет влево, на единице пишет 0 и стоп",
      "fontSize": 32,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "c0hb",
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "BseszKNuSsijCyPBIct7",
      "type": "text",
      "x": 91,
      "y": 9997.45,
      "width": 1085.1,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "zX0j8UUNi4xBkG9unMzV",
      "roundness": null,
      "seed": 820299992,
      "version": 2,
      "versionNonce": 1578634948,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795100000000,
      "link": null,
      "locked": false,
      "text": "нули в хвосте стали единицами, единица перед хвостом стала нулем",
      "originalText": "нули в хвосте стали единицами, единица перед хвостом стала нулем",
      "fontSize": 32,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "c0hc",
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
