      "text": "from ipaddress import ip_network\na = \"172.16.168.0/255.255.248.0\"\ncnt = 0\nfor ip in ip_network(a, strict=False):\n    if bin(int(ip)).count(\"1\") % 5 != 0:\n        cnt += 1\nprint(cnt)",
      "originalText": "from ipaddress import ip_network\na = \"172.16.168.0/255.255.248.0\"\ncnt = 0\nfor ip in ip_network(a, strict=False):\n    if bin(int(ip)).count(\"1\") % 5 != 0:\n        cnt += 1\nprint(cnt)",
