    },
    {
      "id": "1BmVHOic0fULARsMkq5r",
      "type": "text",
      "x": 1340,
      "y": 818.9,
      "width": 534.78,
      "height": 140.4,
      "angle": 0,
      "strokeColor": "#1b2a4a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "Xvak1OjvADuBs4fFDMfF",
      "roundness": null,
      "seed": 405297839,
      "version": 2,
      "versionNonce": 1924248877,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794830000000,
      "link": null,
      "locked": false,
      "text": "159 − 128 = 31 → 1 в разряде 128\n64 и 32 не помещаются → 0 и 0\n31 − 16 = 15 → 1,   15 − 8 = 7 → 1\n7 − 4 = 3 → 1,   3 − 2 = 1 → 1,   1 − 1 = 0 → 1",
      "originalText": "159 − 128 = 31 → 1 в разряде 128\n64 и 32 не помещаются → 0 и 0\n31 − 16 = 15 → 1,   15 − 8 = 7 → 1\n7 − 4 = 3 → 1,   3 − 2 = 1 → 1,   1 − 1 = 0 → 1",
      "fontSize": 26,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.35,
      "index": "b0C"
    },
