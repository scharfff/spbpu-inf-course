      "updated": 1795530270415,
      "link": null,
      "locked": false,
      "text": "for N in range(1, 1000):\n    b = bin(N)[2:]\n    if N % 2 == 0:\n        R = \"1\" + b + \"1\"\n    else:\n        R = b + \"10\"\n    R = int(R, 2)\n    if R > 179:\n        print(N)\n        break",
      "originalText": "for N in range(1, 1000):\n    b = bin(N)[2:]\n    if N % 2 == 0:\n        R = \"1\" + b + \"1\"\n    else:\n        R = b + \"10\"\n    R = int(R, 2)\n    if R > 179:\n        print(N)\n        break",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
