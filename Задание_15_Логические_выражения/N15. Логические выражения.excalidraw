      "updated": 1794922434831,
      "link": null,
      "locked": false,
      "text": "def Del(n, m):\n  return n % m == 0\n\nfor A in range(1, 1000):\n  ok = True\n  for x in range(1, 10000):\n    if ((Del(x, 2) <= (not Del(x, 3))) or (x + A >= 100)) == 0:\n      ok = False\n  if ok:\n    print(A)\n    break",
      "originalText": "def Del(n, m):\n  return n % m == 0\n\nfor A in range(1, 1000):\n  ok = True\n  for x in range(1, 10000):\n    if ((Del(x, 2) <= (not Del(x, 3))) or (x + A >= 100)) == 0:\n      ok = False\n  if ok:\n    print(A)\n    break",
      "fontSize": 28,
      "fontFamily": 8,
