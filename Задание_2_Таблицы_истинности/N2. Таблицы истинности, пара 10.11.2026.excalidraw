  {
   "id": "EcYbTWNbHOqUwLkAgjSB",
   "type": "text",
   "x": 4162,
   "y": 3960,
   "width": 672.6,
   "height": 190.0,
   "angle": 0,
   "strokeColor": "#1b2a4a",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
