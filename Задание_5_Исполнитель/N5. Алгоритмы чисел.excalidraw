      "isDeleted": false,
      "boundElements": [],
      "updated": 1794917000000,
      "link": null,
      "locked": false,
      "text": "Алгоритм по числу N строит число R. Нужно найти наименьшее или\nнаибольшее N либо R, которое подходит под условие из вопроса.",
      "originalText": "Алгоритм по числу N строит число R. Нужно найти наименьшее или\nнаибольшее N либо R, которое подходит под условие из вопроса.",
      "fontSize": 30,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.35,
      "index": "c007",
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
