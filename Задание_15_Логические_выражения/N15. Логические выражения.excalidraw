    {
      "id": "30iLp2uHxsznDHStDWEA",
      "type": "text",
      "x": 2982,
      "y": 343.2,
      "width": 410.2,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1b2a4a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "thQhAMQ6FfdzZDqMiFYp",
      "roundness": null,
      "seed": 949458625,
      "version": 2,
      "versionNonce": 14007445,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794917000000,
      "link": null,
      "locked": false,
      "text": "def f(x, A):\n    return (x >= 45) or (A > x)",
      "originalText": "def f(x, A):\n    return (x >= 45) or (A > x)",
      "fontSize": 24,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
