    {
      "id": "AKyO9d5FCS0mu5zJUX0W",
      "type": "text",
      "x": 5440,
      "y": 2645,
      "width": 405.17,
      "height": 35.1,
      "angle": 0,
      "strokeColor": "#1b2a4a",
