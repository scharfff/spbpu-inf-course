      "isDeleted": false,
      "boundElements": [],
      "updated": 1795724608380,
      "link": null,
      "locked": false,
      "text": "AND дает 1, только если оба\nбита равны 1. \nOR дает 1, если хотя бы один\nбит равен 1. \nXOR дает 1, если биты\nодинаковые, 0 если разные\n(инверсия при ^ 1)",
      "originalText": "AND дает 1, только если оба бита равны 1. \nOR дает 1, если хотя бы один бит равен 1. \nXOR дает 1, если биты одинаковые, 0 если разные\n(инверсия при ^ 1)",
      "fontSize": 26,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.35,
