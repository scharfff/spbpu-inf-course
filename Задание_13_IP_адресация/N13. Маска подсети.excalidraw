      "boundElements": [],
      "updated": 1795707551596,
      "link": null,
      "locked": false,
      "text": "from ipaddress import ip_network\na = \"192.168.159.86/255.255.252.0\"\nnet = ip_network(a, strict=False)\nprint(net.network_address)    # 192.168.156.0\nprint(net.broadcast_address)  # 192.168.159.255\nprint(net.num_addresses)      # 1024\nprint(net.prefixlen)          # 22\nprint(sum(net.network_address.packed))  # 516",
      "originalText": "from ipaddress import ip_network\na = \"192.168.159.86/255.255.252.0\"\nnet = ip_network(a, strict=False)\nprint(net.network_address)    # 192.168.156.0\nprint(net.broadcast_address)  # 192.168.159.255\nprint(net.num_addresses)      # 1024\nprint(net.prefixlen)          # 22\nprint(sum(net.network_address.packed))  # 516",
      "fontSize": 22,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b64",
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "rbUV8nh5voGkuaK1ZLfi",
