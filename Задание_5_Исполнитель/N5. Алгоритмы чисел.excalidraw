      "boundElements": [],
      "updated": 1795100000000,
      "link": null,
      "locked": false,
      "text": "for N in range(1000, 0, -1):\n    b = bin(N)[2:]\n    if N % 3 == 0:\n        b = b + b[-3:]\n    else:\n        b = b + bin(N % 3 * 3)[2:]\n    R = int(b, 2)\n    if R < 130:\n        print(N)\n        break",
      "originalText": "for N in range(1000, 0, -1):\n    b = bin(N)[2:]\n    if N % 3 == 0:\n        b = b + b[-3:]\n    else:\n        b = b + bin(N % 3 * 3)[2:]\n    R = int(b, 2)\n    if R < 130:\n        print(N)\n        break",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
