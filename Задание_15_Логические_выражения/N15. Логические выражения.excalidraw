    {
      "id": "6MOEabpu005dr8aQhvAb",
      "type": "text",
      "x": 60,
      "y": 508.6,
      "width": 1041.04,
      "height": 162,
      "angle": 0,
      "strokeColor": "#1b2a4a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "prkzK4XaxSdrMuPf1mrW",
      "roundness": null,
      "seed": 1752474613,
      "version": 2,
      "versionNonce": 738105226,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794917000000,
      "link": null,
      "locked": false,
      "text": "Дано логическое выражение с параметром A. Нужно найти наименьшее\nили наибольшее A, при котором выражение истинно (или ложно) при\nлюбых значениях переменных. A бывает числом, отрезком или\nмножеством.",
      "originalText": "Дано логическое выражение с параметром A. Нужно найти наименьшее\nили наибольшее A, при котором выражение истинно (или ложно) при\nлюбых значениях переменных. A бывает числом, отрезком или\nмножеством.",
      "fontSize": 30,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.35,
      "index": "a7",
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
