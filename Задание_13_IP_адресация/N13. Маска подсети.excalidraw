      "isDeleted": false,
      "boundElements": [],
      "updated": 1795709021859,
      "link": null,
      "locked": false,
      "text": "получают сразу все квартиры, 192.168.1.255",
      "originalText": "получают сразу все квартиры, 192.168.1.255",
      "fontSize": 24,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
