    {
      "id": "1BmVHOic0fULARsMkq5r",
      "type": "text",
      "x": 1340,
      "y": 818.9,
      "width": 534.78,
      "height": 140.4,
      "angle": 0,
      "strokeColor": "#1b2a4a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
