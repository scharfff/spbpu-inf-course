   "link": null,
   "locked": false,
   "text": "print('w x y z')\nfor w in [0, 1]:\n    for x in [0, 1]:\n        for y in [0, 1]:\n            for z in [0, 1]:\n                F = (x <= y) and (not z)\n                if F == 1:\n                    print(w, x, y, z)",
   "originalText": "print('w x y z')\nfor w in [0, 1]:\n    for x in [0, 1]:\n        for y in [0, 1]:\n            for z in [0, 1]:\n                F = (x <= y) and (not z)\n                if F == 1:\n                    print(w, x, y, z)",
   "fontSize": 26,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
