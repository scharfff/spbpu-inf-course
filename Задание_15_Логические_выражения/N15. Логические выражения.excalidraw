      "link": null,
      "locked": false,
      "text": "def Del(n, m):\n  return n % m == 0\n\nfor A in range(1000, 0, -1):\n  ok = True\n  for x in range(1, 10000):\n    if (Del(x, A) or ((40 <= x <= 50) <= (not\nDel(x, 12)))) == 0:\n      ok = False\n  if ok:\n    print(A)\n    break",
      "originalText": "def Del(n, m):\n  return n % m == 0\n\nfor A in range(1000, 0, -1):\n  ok = True\n  for x in range(1, 10000):\n    if (Del(x, A) or ((40 <= x <= 50) <= (not Del(x, 12)))) == 0:\n      ok = False\n  if ok:\n    print(A)\n    break",
      "fontSize": 28,
      "fontFamily": 8,
