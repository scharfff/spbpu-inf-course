   "text": "x = 1\ny = 0\nprint(x <= y)    # False\nprint(not y)     # True\nprint(x == y)    # False",
   "originalText": "x = 1\ny = 0\nprint(x <= y)    # False\nprint(not y)     # True\nprint(x == y)    # False",
   "fontSize": 26,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "dw8GFYdsywalUPmVBk7x",
   "type": "text",
   "x": 860,
   "y": 3280,
   "width": 596.96,
   "height": 140.4,
   "angle": 0,
   "strokeColor": "#1b2a4a",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
