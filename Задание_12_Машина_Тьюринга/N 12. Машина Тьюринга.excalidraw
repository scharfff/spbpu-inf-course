    {
      "id": "RtJD4dsuBFTqjRqO6OJJ",
      "type": "text",
      "x": 60,
      "y": 1181,
      "width": 1020.38,
      "height": 162,
      "angle": 0,
      "strokeColor": "#1b2a4a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "omJtIbP9ltWoY9LRItk3",
