      "text": "from ipaddress import ip_network\na = \"98.81.154.195/255.252.0.0\"\nnet = ip_network(a, strict=False)\npc = net.broadcast_address - 1\nprint(str(pc).replace(\".\", \"\"))\nprint(sum(pc.packed))",
