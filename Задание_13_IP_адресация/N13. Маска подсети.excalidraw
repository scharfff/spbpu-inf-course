    },
    {
      "id": "IpzuPqUivHtxShDh3Kwr",
      "type": "text",
      "x": 6222,
      "y": 479.1289238188373,
      "width": 1394.51220703125,
      "height": 113.4,
      "angle": 0,
      "strokeColor": "#1b2a4a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "03cmLjGHvHE0FQp8J9y5",
      "roundness": null,
      "seed": 560610392,
      "version": 86,
      "versionNonce": 423966645,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795709021859,
      "link": null,
      "locked": false,
      "text": "Широковещательный адрес это последний адрес сети, все биты узла равны 1. Сообщение на этот адрес\nполучают все компьютеры сети. Компьютеру его не назначают, поэтому наибольший адрес компьютера\nна 1 меньше.",
      "originalText": "Широковещательный адрес это последний адрес сети, все биты узла равны 1. Сообщение на этот адрес\nполучают все компьютеры сети. Компьютеру его не назначают, поэтому наибольший адрес компьютера\nна 1 меньше.",
      "fontSize": 28,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.35,
      "index": "b3E",
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
