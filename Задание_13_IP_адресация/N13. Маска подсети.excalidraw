      "updated": 1794830000000,
      "link": null,
      "locked": false,
      "text": "Пример. 159 в двоичной",
      "originalText": "Пример. 159 в двоичной",
      "fontSize": 28,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
