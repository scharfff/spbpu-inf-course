      "id": "zQYJ7Gr3Y4EgcfnW6SqU",
      "type": "rectangle",
      "x": 2960,
      "y": 321.2,
      "width": 700,
      "height": 104,
      "angle": 0,
      "strokeColor": "#ced4da",
      "backgroundColor": "#f8f9fa",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
